<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui">
  <ribbon>
    <tabs>
      <tab id="tabMathEditor" label="MathEditor">
        <group id="grpEquations" label="MacTeX MathEditor">
          <button id="btnOpenMathEditor" 
                  label="បើក MacTeX MathEditor" 
                  image="logo" 
                  size="large" 
                  onAction="OpenMacTeXMathEditor" 
                  screentip="បើក MacTeX MathEditor" 
                  supertip="បើកផ្ទាំងកម្មវិធី MacTeX MathEditor មកប្រើប្រាស់ផ្ទាល់" />
          <button id="btnToggleTeX" 
                  label="Toggle TeX" 
                  imageMso="EquationInsert" 
                  size="large" 
                  onAction="ToggleTeX" 
                  screentip="Toggle TeX ($...$)" 
                  supertip="បំប្លែងសមីការ $...$ មួយៗដាច់ពីគ្នា ឬបំប្លែងសមីការរូបភាពត្រឡប់ទៅជាអក្សរវិញ" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
